# Copy this file to .env and fill in your real values.
# On Render, set these in the "Environment" tab instead of using a .env file.

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> copy URI)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dream-home?retryWrites=true&w=majority

# The URL of your Netlify site, so the backend only accepts requests from it.
# You can use * temporarily while testing, but lock it down once you have the real URL.
CLIENT_ORIGIN=https://your-site-name.netlify.app

PORT=4000
